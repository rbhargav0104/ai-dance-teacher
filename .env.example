# AI Dance Teacher — environment template. Copy to `.env` (never commit `.env`).
# Defaults below run fully locally with no paid services.

# ---- Backend ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
# Empty = SQLite at $DATA_DIR/app.db. Production must be PostgreSQL.
DATABASE_URL=
# Dev default is insecure on purpose; production refuses it. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
AUTH_MODE=local                     # local (dev/demo only) | supabase (Outcome 10)
STORAGE_PROVIDER=local              # local (private dir under DATA_DIR) | supabase (Outcome 10)
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=./data
MODEL_PATH=./models/pose_landmarker_full.task
ANALYSIS_FPS=12
MAX_DURATION_SECONDS=120
MAX_UPLOAD_MB=200
MAX_PROJECTS_PER_USER=20
MAX_SESSIONS_PER_PROJECT=50
JOB_MAX_ATTEMPTS=3
FFPROBE_TIMEOUT_SECONDS=20

# Production only (Outcome 10). Service-role key stays server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dance-media

# ---- Frontend --------------------------------------------------------------
# Leave empty to call the API same-origin via the Next.js /api rewrite (recommended).
NEXT_PUBLIC_API_URL=
# Where the Next.js server proxies /api/* to.
API_INTERNAL_URL=http://127.0.0.1:8000
